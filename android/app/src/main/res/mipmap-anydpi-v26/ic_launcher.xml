<?xml version="1.0" encoding="utf-8"?>
<!--
  DERMA-SHIELD · adaptive launcher icon manifest entry.

  The launcher resolves `@mipmap/ic_launcher` (see AndroidManifest.xml) to this
  adaptive icon on API 26+, and AGP down-converts it to a flat PNG for API 24/25
  at build time. That is why there are no `mipmap-*dpi` folders in this project.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
