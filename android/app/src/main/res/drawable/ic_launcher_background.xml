<?xml version="1.0" encoding="utf-8"?>
<!--
  DERMA-SHIELD · adaptive launcher icon (background layer)

  Deep-obsidian field with a soft prism halo behind the shield. Flat vector on
  purpose: AGP flattens the two layers into the legacy density buckets at build
  time, so there is no `@mipmap/ic_launcher` PNG to keep in sync.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#06070E"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <path
        android:pathData="M54,20 A34,34 0 1,1 53.9,20 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="44"
                android:gradientRadius="46"
                android:startColor="#2A1A44"
                android:centerColor="#0F2A33"
                android:endColor="#06070E" />
        </aapt:attr>
    </path>
</vector>
